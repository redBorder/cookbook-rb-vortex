#######################################################
## Generated by Chef for <%= node["hostname"] %>
#######################################################
# redborder-vortex daemon configuration
path.settings: "<%= @vortex_dir %>"
pipelines.yml: "<%= @vortex_dir %>/pipelines.yml"
ipc.socket: "/run/redborder-vortex/redborder-vortex.sock"
plugins.dir: "/usr/share/redborder-vortex/plugins"
<% if @is_manager %>

# Redis L2 State Backend & Distributed Lock
redis.url: "redis://redis.service:<%= @redis_port %>"
<% if @redis_password %>
redis.password: <%= @redis_password.to_s.to_json %>
<% end %>
<% unless @db.empty? %>

# PostgreSQL Metadata Sync (sensors, access points, scrambles)
postgres.host: "<%= @db['hostname'] %>"
postgres.port: <%= @db['port'] %>
postgres.database: "<%= @db['database'] %>"
postgres.user: <%= @db['username'].to_s.to_json %>
postgres.password: <%= @db['pass'].to_s.to_json %>
<% end %>
<% end %>
